#[derive(Debug, Clone)]
pub struct Point {
    pub x: f32,
    pub y: f32,
    pub label: String,
}

impl Point {
    pub fn new(x: f32, y: f32, label: String) -> Self {
        Self { x, y, label }
    }
}
