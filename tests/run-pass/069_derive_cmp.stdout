Hearts == Hearts: true
max suit: Hearts
  Card { rank: 2, suit: Clubs }
  Card { rank: 2, suit: Spades }
  Card { rank: 10, suit: Clubs }
  Card { rank: 10, suit: Hearts }
  Card { rank: 14, suit: Diamonds }
