1 + 2 * 3                    => (1 + (2 * 3))                      = 7
(1 + 2) * 3                  => ((1 + 2) * 3)                      = 9
2 ^ 3 ^ 2                    => (2 ^ (3 ^ 2))                      = 512
-2 ^ 2                       => (-(2 ^ 2))                         = -4
x = y = 4                    => x := y := 4                        = 4
x * y - 1                    => ((x * y) - 1)                      = 15
max(1, x, 3) + min(9, 2)     => (max(1, x, 3) + min(9, 2))         = 6
sqrt(16) / 0                 => error: division by zero
sum() + sum(1,2,3)           => (sum() + sum(1, 2, 3))             = 6
z + 1                        => error: undefined z
foo(1)                       => error: bad call foo/1
3 $ 4                        => error: unexpected '$'
(1 + 2                       => error: expected ) got None
1 2                          => error: trailing tokens at 1
r = 0.5 * pi * 2             => r := ((0.5 * pi) * 2)              = 3
{"pi": 3.0, "r": 3.0, "x": 4.0, "y": 4.0}
