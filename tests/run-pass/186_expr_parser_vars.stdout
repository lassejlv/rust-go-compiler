1 + 2 * 3                        => 7
(1 + 2) * 3                      => 9
2 ^ 3 ^ 2                        => 512
-2 ^ 2                           => 4
x = 10                           => x = 10
y = x / 4                        => y = 2.5
x * y - 1                        => 24
r = sqrt(x * x + y * y)          => r = 10.307764064044152
max(1, x, y, 7) + min(3, -y)     => 7.5
sum() + sum(1,2,3) + abs(-0.5)   => 6.5
z + 1                            !! unknown variable 'z'
10 / (x - 10)                    !! division by zero
foo(1)                           !! unknown function 'foo/1'
3 $ 4                            !! unexpected char '$' at 2
(1 + 2                           !! parse error: expected RParen, got None
1 2                              !! parse error: trailing tokens from 1
17 % 5 + 0.25                    => 2.25
[("r", 10.307764064044152), ("x", 10.0), ("y", 2.5)]
