8 opcodes
0x00 nop   |0 [] -- do nothing
0x01 load  |2 ["reg", "imm"] -- load immediate into register
0x02 add   |3 ["dst", "a", "b"] -- dst = a + b
0x03 sub   |3 ["dst", "a", "b"] -- dst = a - b
0x04 mul   |3 ["dst", "a", "b"] -- dst = a * b
0x05 jnz   |2 ["reg", "target"] -- jump if register is non-zero
0x06 print |1 ["reg"] -- print a register
0xff halt  |0 [] -- stop
38 bytes: [01, 00, 00, 06, 00, 01, 01, 00, 01, 00, 01, 02]
   load [0, 6]
   load [1, 1]
   load [2, 1]
    mul [1, 1, 0]
    sub [0, 0, 2]
  print [1]
    jnz [0, 15]
   halt []
output [6, 30, 120, 360, 720, 720]
"frob r1" -> Err("unknown mnemonic `frob`")
"add r1, r2" -> Err("add expects 3 args (dst, a, b), got 2")
"jnz r0, nowhere" -> Err("undefined label nowhere")
"load rx, 1" -> Err("bad register rx: invalid digit found in string")
[("one", 1), ("two", 2), ("three", 3)] cap>=true
{1, 3, 5} 5
