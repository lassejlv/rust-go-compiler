1 + 2 * 3                      => (1 + (2 * 3))                            = Ok(7.0)
(1 + 2) * 3                    => ((1 + 2) * 3)                            = Ok(9.0)
2 ** 3 ** 2                    => (2 ** (3 ** 2))                          = Ok(512.0)
-2 ** 2                        => (-(2 ** 2))                              = Ok(-4.0)
-x + -y * 2                    => ((-x) + ((-y) * 2))                      = Ok(-11.0)
10 - 4 - 3                     => ((10 - 4) - 3)                           = Ok(3.0)
100 / 10 / 5                   => ((100 / 10) / 5)                         = Ok(2.0)
3! + 1                         => ((3!) + 1)                               = Ok(7.0)
x < y && y < 5 || 0            => (((x < y) && (y < 5)) || 0)              = Ok(1.0)
!(x == 3) ? 1 : 2              => ((!(x == 3)) ? 1 : 2)                    = Ok(2.0)
x > 2 ? y > 10 ? 1 : 2 : 3     => ((x > 2) ? ((y > 10) ? 1 : 2) : 3)       = Ok(2.0)
max(x, y, 2 * x) + min(1, abs(-7)) => (max(x, y, (2 * x)) + min(1, abs((-7)))) = Ok(7.0)
sqrt(x*x + y*y)                => sqrt(((x * x) + (y * y)))                = Ok(5.0)
17 % 5 * 2                     => ((17 % 5) * 2)                           = Ok(4.0)
1 / (x - 3)                    => (1 / (x - 3))                            = Err("division by zero")
foo(1)                         => foo(1)                                   = Err("bad call foo/1")
z + 1                          => (z + 1)                                  = Err("unbound z")
1 +                            => parse error: unexpected token Eof
(1 + 2                         => parse error: expected RParen, got Eof
1 2                            => parse error: trailing Num(2.0)
3 $ 4                          => parse error: unexpected '$' at 2
